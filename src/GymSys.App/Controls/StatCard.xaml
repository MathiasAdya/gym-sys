<UserControl x:Class="GymSys.App.Controls.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- Contoh pakai:
         <controls:StatCard Title="Total Member Aktif" Value="142" Icon="👥"
                            AccentBrush="{DynamicResource SuccessBrush}" Caption="+18 bulan ini"/> -->
    <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="48" Height="48" CornerRadius="12" VerticalAlignment="Center"
                    Background="{Binding AccentBrush, ElementName=Root}">
                <TextBlock Text="{Binding Icon, ElementName=Root}" FontSize="22" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                <!-- Nilai panjang (mis. pendapatan) mengecil sendiri, tidak terpotong, saat kartu sempit. -->
                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Value, ElementName=Root}" FontSize="28" FontWeight="Bold"/>
                </Viewbox>
                <TextBlock Text="{Binding Caption, ElementName=Root}" Style="{StaticResource Muted}" FontSize="12"
                           Visibility="{Binding Caption, ElementName=Root, Converter={StaticResource StringToVis}}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
