<Window x:Class="GymSys.App.Controls.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Konfirmasi" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="14">

    <!-- Dialog konfirmasi bertema. Dipanggil lewat IDialogService.Confirm(...), jangan dibuat langsung. -->
    <Border Style="{StaticResource Card}" Margin="16" Padding="24">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="MessageText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,24"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Batal" IsCancel="True" MinWidth="96" Margin="0,0,10,0"/>
                <Button x:Name="ConfirmButton" Content="Ya" IsDefault="True" MinWidth="96"
                        Style="{StaticResource PrimaryButton}" Click="OnConfirm"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
