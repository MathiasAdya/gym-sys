<UserControl x:Class="GymSys.App.Controls.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- Kotak pencarian dengan debounce (FR05: 300 ms, minimal 2 karakter).
         Contoh pakai di layar Member:
         <controls:SearchBox Placeholder="Cari kode, nama, atau No. HP"
                             SearchText="{Binding SearchText, Mode=TwoWay}"
                             Command="{Binding SearchCommand}" Width="320"/>
         SearchText hanya berubah SETELAH debounce, jadi aman dipakai langsung untuk query. -->
    <Grid>
        <TextBox x:Name="Input" Padding="36,9,36,9" TextChanged="OnInputChanged"/>

        <TextBlock Text="🔍" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                   IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>

        <TextBlock x:Name="PlaceholderText" Text="{Binding Placeholder, ElementName=Root}"
                   Style="{StaticResource Muted}" IsHitTestVisible="False"
                   VerticalAlignment="Center" Margin="37,0,36,0" TextTrimming="CharacterEllipsis"/>

        <Button x:Name="ClearButton" Content="✕" Click="OnClear" Visibility="Collapsed"
                Style="{StaticResource AppButton}" Foreground="{DynamicResource TextSecondaryBrush}"
                Padding="8,4" Margin="0,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                ToolTip="Hapus pencarian"/>
    </Grid>
</UserControl>
