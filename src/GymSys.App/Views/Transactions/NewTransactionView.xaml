<UserControl x:Class="GymSys.App.Views.NewTransactionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GymSys.App.Controls">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1100" HorizontalAlignment="Left">

                <!-- Banner error -->
                <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource DangerBrush}"
                        Margin="0,0,0,16" Padding="16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Muat ulang paket" Command="{Binding RetryCommand}"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                    </DockPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== 1. Member ===== -->
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="1. Pilih Member" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding SearchInfo}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,12"/>

                            <controls:SearchBox Placeholder="Cari nama, kode, atau no. HP..."
                                                SearchText="{Binding SearchText, Mode=TwoWay}"/>

                            <ListBox ItemsSource="{Binding Members}" DisplayMemberPath="Display"
                                     SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                                     Height="220" Margin="0,12,0,0"
                                     Background="{DynamicResource InputBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource LineBrush}"/>

                            <TextBlock Text="{Binding StatusMemberText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Visibility="{Binding StatusMemberText, Converter={StaticResource StringToVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== 2. Paket & pembayaran ===== -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="2. Paket &amp; Pembayaran" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                            <TextBlock Text="Paket" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding Plans}" DisplayMemberPath="Display"
                                      SelectedItem="{Binding SelectedPlan, Mode=TwoWay}"/>

                            <TextBlock Text="Tanggal mulai aktif" FontWeight="SemiBold" Margin="0,14,0,6"/>
                            <DatePicker x:Name="TglMulaiPicker" SelectedDate="{Binding TglMulai, Mode=TwoWay}"
                                        Background="{DynamicResource InputBackgroundBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderBrush="{DynamicResource LineBrush}" Padding="6"/>
                            <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=TglMulaiPicker}"
                                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding TglMulaiHint}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Diskon (Rp)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="DiskonBox" Text="{Binding Diskon, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=DiskonBox}"
                                               Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Metode bayar" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding MetodeOptions}" SelectedItem="{Binding MetodeBayar, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Pratinjau -->
                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Masa aktif" Style="{StaticResource Muted}" Margin="0,0,16,6"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PeriodeText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="1" Text="Harga paket" Style="{StaticResource Muted}" Margin="0,0,16,6"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HargaText}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="2" Text="Diskon" Style="{StaticResource Muted}" Margin="0,0,16,6"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DiskonText}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="3" Text="Total bayar" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalText}" FontWeight="Bold" FontSize="18"
                                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Button Content="Simpan Transaksi" Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <controls:LoadingOverlay Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>
