<UserControl x:Class="GymSys.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GymSys.App.Controls">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Banner error + coba lagi -->
            <Border Grid.Row="0" Style="{StaticResource Card}" BorderBrush="{DynamicResource DangerBrush}"
                    Margin="0,0,0,16" Padding="16"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Coba lagi" Command="{Binding RetryCommand}"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                </DockPanel>
            </Border>

            <!-- Filter -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="20,16">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="⬇ Ekspor CSV" Command="{Binding ExportCommand}"
                            Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="250" Margin="0,0,16,0">
                            <TextBlock Text="Jenis laporan" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ReportTypes}" DisplayMemberPath="Title"
                                      SelectedItem="{Binding SelectedReportType, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Width="200">
                            <TextBlock Text="Periode" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Periods}" DisplayMemberPath="Title"
                                      SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}"
                                      IsEnabled="{Binding IsPeriodEnabled}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Hasil -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding SummaryText}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1">
                        <!-- Riwayat transaksi -->
                        <DataGrid ItemsSource="{Binding Transactions}"
                                  Visibility="{Binding ShowTransactions, Converter={StaticResource BoolToVis}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="No. Kuitansi" Binding="{Binding NoKuitansi}" Width="Auto"/>
                                <DataGridTextColumn Header="Tanggal" Width="Auto"
                                                    Binding="{Binding TglTransaksi, StringFormat='dd MMM yyyy HH:mm', ConverterCulture=id-ID}"/>
                                <DataGridTextColumn Header="Member" Binding="{Binding NamaMember}" Width="*"/>
                                <DataGridTextColumn Header="Paket" Binding="{Binding NamaPaket}" Width="Auto"/>
                                <DataGridTextColumn Header="Total" Width="Auto"
                                                    Binding="{Binding TotalBayar, StringFormat=C0, ConverterCulture=id-ID}"/>
                                <DataGridTextColumn Header="Metode" Binding="{Binding MetodeBayar}" Width="Auto"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Batal">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Status member -->
                        <DataGrid ItemsSource="{Binding StatusRows}"
                                  Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVis}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kode" Binding="{Binding KodeMember}" Width="Auto"/>
                                <DataGridTextColumn Header="Nama" Binding="{Binding NamaLengkap}" Width="*"/>
                                <DataGridTextColumn Header="No. HP" Binding="{Binding NoTelepon}" Width="Auto"/>
                                <DataGridTextColumn Header="Berakhir" Width="Auto"
                                                    Binding="{Binding TglBerakhir, StringFormat='dd MMM yyyy', ConverterCulture=id-ID, TargetNullValue='-'}"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Aktif">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Akan Habis">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Kedaluwarsa">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Pendapatan per paket (Admin) -->
                        <DataGrid ItemsSource="{Binding RevenueRows}"
                                  Visibility="{Binding ShowRevenue, Converter={StaticResource BoolToVis}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Paket" Binding="{Binding NamaPaket}" Width="*"/>
                                <DataGridTextColumn Header="Jumlah Transaksi" Binding="{Binding JumlahTransaksi}" Width="Auto"/>
                                <DataGridTextColumn Header="Total Pendapatan" Width="Auto"
                                                    Binding="{Binding TotalPendapatan, StringFormat=C0, ConverterCulture=id-ID}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty state -->
                        <TextBlock Text="Tidak ada data untuk laporan dan periode yang dipilih."
                                   Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <controls:LoadingOverlay Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>
