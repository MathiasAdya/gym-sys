<UserControl x:Class="GymSys.App.Views.MembersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GymSys.App.Controls"
             xmlns:vm="clr-namespace:GymSys.App.ViewModels"
             PreviewKeyDown="OnPreviewKeyDown"
             Loaded="OnLoaded">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Banner error -->
            <Border Grid.Row="0" Style="{StaticResource Card}" BorderBrush="{DynamicResource DangerBrush}"
                    Margin="0,0,0,16" Padding="16"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Coba lagi" Command="{Binding RetryCommand}"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                </DockPanel>
            </Border>

            <!-- Pencarian, filter, dan tombol tambah -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="20,16">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="+ Tambah Member"
                                ToolTip="Tambah member baru (Ctrl+N)"
                                Command="{Binding AddCommand}"
                                Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"
                                Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Cari member (Ctrl+F)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                <controls:SearchBox x:Name="Search"
                                                    Placeholder="Cari kode, nama, atau No. HP"
                                                    SearchText="{Binding SearchText, Mode=TwoWay}"
                                                    Command="{Binding SearchCommand}"
                                                    Width="320"/>
                            </StackPanel>
                            <StackPanel Width="200">
                                <TextBlock Text="Status" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Title"
                                          SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Hanya menampilkan member yang ditugaskan kepada Anda."
                               Style="{StaticResource Muted}" Margin="0,10,0,0"
                               Visibility="{Binding IsInstruktur, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Hasil -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="MembersGrid" ItemsSource="{Binding Rows}"
                              MouseDoubleClick="OnRowDoubleClick"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kode" Binding="{Binding KodeMember}" Width="140"/>
                            <DataGridTextColumn Header="Nama" Binding="{Binding NamaLengkap}" Width="*" MinWidth="180"/>
                            <DataGridTextColumn Header="No. HP" Binding="{Binding NoTelepon}" Width="150"/>
                            <DataGridTextColumn Header="Berakhir" Width="130"
                                                Binding="{Binding TglBerakhirTerakhir, StringFormat='dd MMM yyyy', ConverterCulture=id-ID, TargetNullValue='-'}"/>
                            <DataGridTemplateColumn Header="Status" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Aktif">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="AkanHabis">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Kedaluwarsa">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Aksi" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Detail" Style="{StaticResource GhostButton}" Padding="10,4"
                                                    Command="{Binding DataContext.DetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Ubah" Style="{StaticResource GhostButton}" Padding="10,4" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="{Binding EmptyText}"
                               Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

                    <controls:PagingBar Grid.Row="1" Margin="0,12,0,0"
                                        PageIndex="{Binding PageIndex, Mode=TwoWay}"
                                        PageSize="{x:Static vm:MembersViewModel.PageSize}"
                                        TotalItems="{Binding TotalItems}"
                                        Command="{Binding GoToPageCommand}"/>
                </Grid>
            </Border>
        </Grid>

        <controls:LoadingOverlay Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>
