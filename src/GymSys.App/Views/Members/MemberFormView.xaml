<UserControl x:Class="GymSys.App.Views.MemberFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GymSys.App.Controls"
             xmlns:core="clr-namespace:GymSys.Core.Services;assembly=GymSys.Core"
             Loaded="OnLoaded">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Width="900">

                <!-- Banner error -->
                <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource DangerBrush}"
                        Margin="0,0,0,16" Padding="16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
                </Border>

                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <!-- Judul -->
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                            <Run Text="Kode member: "/><Run Text="{Binding KodeMember, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                   Visibility="{Binding IsEdit, Converter={StaticResource BoolToVis}}">
                            <Run Text="Bergabung: "/><Run Text="{Binding TglBergabungText, Mode=OneWay}"/><Run Text="  ·  Status: "/><Run Text="{Binding StatusText, Mode=OneWay}"/>
                        </TextBlock>

                        <!-- Isian -->
                        <StackPanel IsEnabled="{Binding IsLoaded}" Margin="0,20,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Nama lengkap *" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="NamaBox"
                                             Text="{Binding NamaLengkap, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="{x:Static core:MasterDataRules.MaksPanjangNama}"/>
                                    <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=NamaBox}"
                                               Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>

                                    <TextBlock Text="No. HP *" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="NoTeleponBox"
                                             Text="{Binding NoTelepon, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="{x:Static core:MasterDataRules.MaksDigitTelepon}"/>
                                    <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=NoTeleponBox}"
                                               Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>

                                    <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="EmailBox"
                                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="{x:Static core:MasterDataRules.MaksPanjangEmail}"/>
                                    <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=EmailBox}"
                                               Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tanggal lahir" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <DatePicker x:Name="TglLahirPicker"
                                                SelectedDate="{Binding TglLahir, Mode=TwoWay}"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                BorderBrush="{DynamicResource LineBrush}" Padding="6"/>
                                    <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=TglLahirPicker}"
                                               Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>

                                    <TextBlock Text="Jenis kelamin" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding JenisKelaminOptions}" DisplayMemberPath="Title"
                                              SelectedItem="{Binding SelectedJenisKelamin, Mode=TwoWay}" Margin="0,0,0,10"/>

                                    <TextBlock Text="Kontak darurat" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding KontakDarurat, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="{x:Static core:MemberService.MaksPanjangKontakDarurat}"/>
                                    <TextBlock Text="Nama dan nomor yang bisa dihubungi" Style="{StaticResource Muted}"
                                               FontSize="12" Margin="0,4,0,10"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Alamat" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Alamat, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="{x:Static core:MemberService.MaksPanjangAlamat}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="64" Margin="0,0,0,14"/>

                            <TextBlock Text="Catatan kesehatan" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding CatatanKesehatan, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="{x:Static core:MemberService.MaksPanjangCatatanKesehatan}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="88"/>
                            <TextBlock Text="Mis. riwayat cedera, penyakit jantung, asma, atau alergi."
                                       Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Tombol -->
                        <DockPanel Margin="0,24,0,0" LastChildFill="False">
                            <Button DockPanel.Dock="Left" Content="Simpan" Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                    IsEnabled="{Binding IsLoaded}"/>
                            <Button DockPanel.Dock="Left" Content="Batal" Command="{Binding CancelCommand}"
                                    Style="{StaticResource GhostButton}"/>
                            <Button DockPanel.Dock="Right" Content="{Binding ToggleActiveText}"
                                    Command="{Binding ToggleActiveCommand}"
                                    Style="{StaticResource GhostButton}"
                                    IsEnabled="{Binding IsLoaded}"
                                    Visibility="{Binding IsEdit, Converter={StaticResource BoolToVis}}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <controls:LoadingOverlay Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>
