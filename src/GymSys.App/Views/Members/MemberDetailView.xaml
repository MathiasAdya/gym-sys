<UserControl x:Class="GymSys.App.Views.MemberDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GymSys.App.Controls">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Tombol atas -->
                <DockPanel Margin="0,0,0,16" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Content="← Kembali ke daftar" Command="{Binding BackCommand}"
                            Style="{StaticResource GhostButton}"/>
                    <Button DockPanel.Dock="Right" Content="Perpanjang" Command="{Binding RenewCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                            ToolTip="Buka layar Transaksi dengan member ini"
                            Visibility="{Binding CanRenew, Converter={StaticResource BoolToVis}}"/>
                    <Button DockPanel.Dock="Right" Content="Ubah Data" Command="{Binding EditCommand}"
                            Style="{StaticResource GhostButton}"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                </DockPanel>

                <!-- Banner error -->
                <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource DangerBrush}"
                        Margin="0,0,0,16" Padding="16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Coba lagi" Command="{Binding RetryCommand}"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                    </DockPanel>
                </Border>

                <StackPanel Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">

                    <!-- Ringkasan -->
                    <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" VerticalAlignment="Top" CornerRadius="8" Padding="14,6"
                                    Background="{DynamicResource SurfaceAltBrush}">
                                <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Aktif">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="AkanHabis">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Kedaluwarsa">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding NamaLengkap}" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                                    <Run Text="{Binding KodeMember, Mode=OneWay}"/><Run Text="  ·  Bergabung "/><Run Text="{Binding TglBergabung, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding SisaText}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Profil, kesehatan, instruktur -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Profil" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="No. HP" Style="{StaticResource Muted}" Margin="0,0,24,8"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NoTelepon}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Text="Email" Style="{StaticResource Muted}" Margin="0,0,24,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Email}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Text="Jenis kelamin" Style="{StaticResource Muted}" Margin="0,0,24,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding JenisKelamin}"/>
                                    <TextBlock Grid.Row="3" Text="Tanggal lahir" Style="{StaticResource Muted}" Margin="0,0,24,8"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TglLahir}"/>
                                    <TextBlock Grid.Row="4" Text="Alamat" Style="{StaticResource Muted}" Margin="0,0,24,8"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Alamat}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="5" Text="Kontak darurat" Style="{StaticResource Muted}" Margin="0,0,24,0"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding KontakDarurat}" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Catatan kesehatan" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding CatatanKesehatan}" TextWrapping="Wrap"/>

                                <TextBlock Text="Instruktur (PT)" Style="{StaticResource SectionTitle}" Margin="0,24,0,8"/>
                                <TextBlock Text="{Binding Instruktur}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Riwayat transaksi -->
                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Riwayat transaksi" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                            <DataGrid ItemsSource="{Binding Transactions}" AutoGenerateColumns="False" IsReadOnly="True"
                                      MaxHeight="360">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="No. Kuitansi" Binding="{Binding NoKuitansi}" Width="170"/>
                                    <DataGridTextColumn Header="Tanggal" Width="160"
                                                        Binding="{Binding TglTransaksi, StringFormat='dd MMM yyyy HH:mm', ConverterCulture=id-ID}"/>
                                    <DataGridTextColumn Header="Paket" Binding="{Binding NamaPaket}" Width="*" MinWidth="120"/>
                                    <DataGridTextColumn Header="Masa aktif" Width="230">
                                        <DataGridTextColumn.Binding>
                                            <MultiBinding StringFormat="{}{0:dd MMM yyyy} – {1:dd MMM yyyy}" ConverterCulture="id-ID">
                                                <Binding Path="TglMulaiAktif"/>
                                                <Binding Path="TglBerakhir"/>
                                            </MultiBinding>
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Total" Width="130"
                                                        Binding="{Binding TotalBayar, StringFormat=C0, ConverterCulture=id-ID}"/>
                                    <DataGridTemplateColumn Header="Status" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           ToolTip="{Binding AlasanBatal}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLunas}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Belum ada transaksi." Style="{StaticResource Muted}" Margin="0,12,0,0"
                                       Visibility="{Binding HasNoTransactions, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <controls:LoadingOverlay Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>
