<UserControl x:Class="GymSys.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GymSys.App.Controls">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Banner error + tombol coba lagi (NFR-06) -->
                <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource DangerBrush}"
                        Margin="0,0,0,16" Padding="16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Coba lagi" Command="{Binding RetryCommand}"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                    </DockPanel>
                </Border>

                <!-- Kartu statistik (kartu pendapatan hanya muncul untuk Admin) -->
                <UniformGrid Rows="1" Margin="0,0,-16,0">
                    <controls:StatCard Title="Total Member Aktif" Value="{Binding TotalMemberAktif}" Icon="👥"
                                       AccentBrush="{DynamicResource AccentBrush}" Margin="0,0,16,16"/>
                    <controls:StatCard Title="Member Baru Bulan Ini" Value="{Binding MemberBaruBulanIni}" Icon="✨"
                                       AccentBrush="{DynamicResource SuccessBrush}" Margin="0,0,16,16"/>
                    <controls:StatCard Title="Akan Habis 7 Hari" Value="{Binding AkanHabis7Hari}" Icon="⏳"
                                       AccentBrush="{DynamicResource WarningBrush}" Margin="0,0,16,16"/>
                    <controls:StatCard Title="Pendapatan Bulan Ini" Value="{Binding PendapatanText}" Icon="💰"
                                       AccentBrush="{DynamicResource InfoBrush}" Margin="0,0,16,16"
                                       Visibility="{Binding ShowRevenue, Converter={StaticResource BoolToVis}}"/>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.25*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Grafik tren pendaftaran 12 bulan (batang native WPF, tanpa library tambahan) -->
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Tren Pendaftaran 12 Bulan" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Jumlah member baru per bulan" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,16"/>

                            <ItemsControl ItemsSource="{Binding Trend}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="3,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="20"/>
                                                <RowDefinition Height="150"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource Muted}" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                            <Border Grid.Row="1" Height="{Binding BarHeight}" MinWidth="8"
                                                    VerticalAlignment="Bottom" CornerRadius="4,4,0,0"
                                                    Background="{DynamicResource AccentBrush}"/>
                                            <TextBlock Grid.Row="2" Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="11"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Tabel member yang akan habis -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Akan Habis dalam 7 Hari" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Urut dari tanggal berakhir terdekat" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,12"/>

                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpiringEmpty}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <DataGrid ItemsSource="{Binding Expiring}" MaxHeight="340">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Kode" Binding="{Binding KodeMember}" Width="Auto"/>
                                        <DataGridTextColumn Header="Nama" Binding="{Binding NamaLengkap}" Width="*"/>
                                        <DataGridTextColumn Header="No. HP" Binding="{Binding NoTelepon}" Width="Auto"/>
                                        <DataGridTextColumn Header="Berakhir" Width="Auto"
                                                            Binding="{Binding TglBerakhir, StringFormat='dd MMM yyyy', ConverterCulture=id-ID}"/>
                                        <DataGridTextColumn Header="Sisa" Width="Auto"
                                                            Binding="{Binding SisaHari, StringFormat='{}{0} hari'}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                            <!-- Empty state -->
                            <TextBlock Text="Tidak ada member yang akan habis dalam 7 hari ke depan."
                                       Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,8"
                                       Visibility="{Binding IsExpiringEmpty, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- State loading -->
        <controls:LoadingOverlay Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>
