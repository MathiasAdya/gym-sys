<UserControl x:Class="GymSys.App.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,16">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,24">
                    <TextBlock Text="🏋 GYM-SYS" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Manajemen Keanggotaan" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="GYM-SYS v1.0" Style="{StaticResource Muted}"
                           FontSize="11" Margin="8,12,0,0"/>

                <ListBox ItemsSource="{Binding MenuItems}"
                         SelectedItem="{Binding SelectedMenu, Mode=TwoWay}"
                         Style="{StaticResource SidebarListBox}"
                         ItemContainerStyle="{StaticResource SidebarItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" Width="30" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Area utama ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="{Binding ThemeToggleText}" Command="{Binding ToggleThemeCommand}"
                                Padding="14,8" Margin="0,0,20,0"/>

                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding RoleText}" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right"/>
                        </StackPanel>

                        <Button Content="Keluar" Command="{Binding LogoutCommand}" Padding="14,8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Konten halaman aktif (View dipilih lewat Views/ViewMap.xaml) -->
            <ContentControl Grid.Row="1" Content="{Binding Content}" Margin="24"/>
        </Grid>
    </Grid>
</UserControl>
