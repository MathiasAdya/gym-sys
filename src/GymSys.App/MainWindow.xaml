<Window x:Class="GymSys.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GYM-SYS - Sistem Manajemen Keanggotaan Gym"
        Width="1280" Height="760" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="14">

    <!-- Satu-satunya isi jendela: ViewModel aktif (Login atau Shell), dirender lewat DataTemplate di Views/ViewMap.xaml -->
    <ContentControl Content="{Binding Root}"/>
</Window>
