<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tema TERANG. Nama key HARUS sama persis dengan Dark.xaml. -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LineBrush" Color="#CBD5E1"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#0891B2"/>

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EEF2F7"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#CCF1F5F9"/>

</ResourceDictionary>
